# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
# 127.0.0.1 doit rester présent : le HEALTHCHECK Docker interroge http://127.0.0.1:8000/api/test-connection/
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Engine (use django.db.backends.mysql for production with Docker)
DATABASE_ENGINE=django.db.backends.mysql

# MySQL Database Configuration
MYSQL_DATABASE=blanco-db
# Utilisateur applicatif dédié (recommandé) : ne pas utiliser root pour l'application.
# L'image MySQL crée cet utilisateur au premier démarrage (avec MYSQL_PASSWORD)
# et lui accorde tous les droits sur MYSQL_DATABASE. Note : l'image refuse MYSQL_USER=root.
MYSQL_USER=blanco
MYSQL_PASSWORD=your-mysql-password
# Requis par docker-compose : initialisation du conteneur MySQL et healthcheck.
MYSQL_ROOT_PASSWORD=change-me
# Le conteneur web tourne en network_mode: host (détection de l'IP LAN / QR code) et
# MySQL n'est publié que sur la boucle locale de l'hôte (127.0.0.1:3306) : on se
# connecte donc via 127.0.0.1. Cas Windows (docker-compose.win.yml, réseau bridge) :
# utiliser MYSQL_HOST=mysql (nom du service).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ------------------------------------------------------------------
# Variables optionnelles
# ------------------------------------------------------------------
# À True, l'application active les cookies Secure, HSTS et la redirection SSL :
# à activer uniquement derrière TLS (reverse proxy HTTPS), jamais en HTTP simple.
# USE_HTTPS=False
# Origines de confiance pour CSRF (séparées par des virgules) lorsque l'application
# est servie derrière un reverse proxy HTTPS.
# CSRF_TRUSTED_ORIGINS=https://blanco.example.com
# Mot de passe du superutilisateur "admin" créé par create_superuser.py
# DJANGO_SUPERUSER_PASSWORD=
# Méthode de détection de l'IP LAN : 1 = via `ip route` (nécessaire dans Docker en
# mode host), 0 = méthode par défaut.
# GET_IP_METHOD=0

# ------------------------------------------------------------------
# Mode de déploiement
# ------------------------------------------------------------------
# standalone (défaut) : installation mono-client — une installation = une
#   entreprise. C'est le mode du Docker sur le réseau local du commerce et de
#   l'exécutable Windows. Rien à renseigner ci-dessous.
# saas : plateforme hébergée multi-entreprises — une base MySQL par société,
#   résolue depuis le nom d'hôte de la requête.
# BLANCO_MODE=standalone

# ---- Variables requises UNIQUEMENT lorsque BLANCO_MODE=saas ----
# Domaine racine de la plateforme. Le site public et l'inscription sont servis
# sur ce domaine et sur www., le back-office sur admin. ; tout autre nom d'hôte
# désigne l'espace d'un client (sous-domaine ou domaine propre).
# BLANCO_PLATFORM_DOMAIN=blanco.app
#
# Cache partagé, OBLIGATOIRE en mode saas : sans lui, le cache est en mémoire
# par processus et la limitation des tentatives de connexion devient
# inopérante dès que gunicorn tourne avec plusieurs workers. Renseignable
# aussi en mono-client, où il corrige le même défaut.
# REDIS_URL=redis://127.0.0.1:6379/0
#
# Durée de vie des connexions aux bases des sociétés. 0 = une connexion par
# requête. Le pire cas est workers × threads × sociétés servies par ce fil :
# avec des connexions persistantes et quelques centaines de clients, on
# dépasse largement le max_connections de MySQL. Ne relever qu'après mesure.
# TENANT_CONN_MAX_AGE=0
#
# À True (défaut), une écriture métier pendant une requête HTTP sans société
# active lève une exception au lieu d'atterrir silencieusement dans la base de
# la plateforme. Échouer bruyamment vaut mieux qu'une fuite d'écriture.
# BLANCO_STRICT_TENANT=True
#
# Compte MySQL autorisé à créer les bases des nouvelles sociétés. Distinct du
# compte applicatif et réservé au processus de travaux : le conteneur web ne
# doit PAS recevoir ces identifiants, pour qu'une faille du serveur web ne
# permette ni de créer ni de détruire des bases.
# MYSQL_PROVISION_USER=blanco_provision
# MYSQL_PROVISION_PASSWORD=

# ------------------------------------------------------------------
# Envoi d'e-mails
# ------------------------------------------------------------------
# Sans EMAIL_HOST, l'application utilise un backend « dummy » qui absorbe les
# envois sans erreur : le mode mono-client n'a besoin d'aucun SMTP.
# Le mode saas l'exige (vérification d'adresse, invitations, mots de passe).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Blanco <ne-pas-repondre@blanco.app>
